---
// Fonts ship with the app (no Google Fonts request), so the desktop build
// and the web version look the same offline.
import '@fontsource/courier-prime/latin-400.css';
import '@fontsource/courier-prime/latin-400-italic.css';
import '@fontsource/courier-prime/latin-700.css';
import '@fontsource/courier-prime/latin-700-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<script is:inline>
  // Desktop app (Tauri): the marketing page isn't needed, go straight to the projects.
  if ('__TAURI_INTERNALS__' in window && location.pathname === '/') location.replace('/projects');
  // Apply theme, paper colour and language before paint to avoid a flash.
  try {
    const s = JSON.parse(localStorage.getItem('tewrite:settings') || '{}');
    const t = s.theme || 'system';
    if (t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches))
      document.documentElement.classList.add('dark');
    if (s.paperColor === 'light' || s.paperColor === 'dark') document.documentElement.dataset.paper = s.paperColor;
    if (s.lang && s.lang !== 'en') {
      document.documentElement.lang = s.lang;
      document.documentElement.classList.add('i18n-pending');
      setTimeout(() => document.documentElement.classList.remove('i18n-pending'), 1500);
    }
  } catch {}
</script>
<script>
  // Styled tooltips for every title attribute (scripts/tooltips.ts).
  import { initTooltips } from '../scripts/tooltips';
  initTooltips();
</script>
