---
import '../styles/global.css';
import HeadBoot from '../components/HeadBoot.astro';
import Logo from '../components/Logo.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import Loader from '../components/Loader.astro';
import { en_ as T, type Key } from '../scripts/i18n';

const icon = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
// Dark theme background: screenplay words that float up.
const fragments = [
  { text: 'INT.', x: 6, dur: 26, delay: 0, size: 15 },
  { text: 'FADE IN:', x: 18, dur: 32, delay: 9, size: 13 },
  { text: 'CUT TO:', x: 34, dur: 28, delay: 4, size: 14 },
  { text: 'EXT.', x: 52, dur: 30, delay: 14, size: 16 },
  { text: '(beat)', x: 66, dur: 24, delay: 2, size: 13 },
  { text: "(CONT'D)", x: 78, dur: 34, delay: 11, size: 12 },
  { text: 'DISSOLVE TO:', x: 88, dur: 29, delay: 6, size: 12 },
  { text: '- NIGHT', x: 44, dur: 36, delay: 19, size: 13 },
];

const features: { t: Key; d: Key; b: Key; icon: string }[] = [
  { t: 'land.f1t', d: 'land.f1d', b: 'land.bWrite', icon: icon('<path d="M6 2h9l5 5v15H6z"/><path d="M9 12h6M9 16h6M9 8h2"/>') },
  { t: 'land.f2t', d: 'land.f2d', b: 'land.bWrite', icon: icon('<rect x="3" y="4" width="18" height="6" rx="1.5"/><path d="M6 14h12M6 18h8"/><path d="m16 6 1.5 1.5L19 6"/>') },
  { t: 'land.f3t', d: 'land.f3d', b: 'land.bPlan', icon: icon('<rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/>') },
  { t: 'land.f4t', d: 'land.f4d', b: 'land.bShoot', icon: icon('<path d="M4 9h16v11H4z"/><path d="m4 9 2.5-5h3L7 9M11 9l2.5-5h3L14 9M18 9l2-4"/>') },
  { t: 'land.f5t', d: 'land.f5d', b: 'land.bShare', icon: icon('<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>') },
  { t: 'land.f6t', d: 'land.f6d', b: 'land.bPrivate', icon: icon('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/><path d="m9.5 10 2 2 3.5-3.5"/>') },
];
---

<html lang="en">
  <head>
    <HeadBoot title={T('land.pageTitle')} />
    <meta name="description" content={T('land.lead')} />
  </head>
  <body class="app landing min-h-screen">
    <Loader label={T('ui.loading')} hidden />
    <!-- Light theme: rain background (adapted from Uiverse.io by SelfMadeSystem), in Terra purple -->
    <div class="land-bg rain-bg" aria-hidden="true"></div>
    <!-- Dark theme: drifting light, drafting grid and screenplay fragments -->
    <div class="land-bg aurora-bg" aria-hidden="true">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <div class="grid-bg"></div>
      {fragments.map((f) => (
        <span class="frag" style={`left:${f.x}%;animation-duration:${f.dur}s;animation-delay:${f.delay}s;font-size:${f.size}px`}>{f.text}</span>
      ))}
    </div>
    <header class="land-header">
      <div class="land-wrap flex items-center gap-3 h-16">
        <a href="/" class="home-link" aria-label="Terra Script">
          <Logo id="lhdr" class="brand-logo brand-logo-lg" />
        </a>
        <div class="ml-auto flex items-center gap-2">
          <label class="sr-only" for="lang-select" data-i18n="proj.language">{T('proj.language')}</label>
          <select id="lang-select" class="field-select">
            <option value="en">English</option>
            <option value="id">Bahasa Indonesia</option>
          </select>
          <ThemeSwitch label={T('proj.theme')} />
          <a href="/projects" class="btn btn-primary hidden sm:inline-flex"><span data-i18n="land.openApp">{T('land.openApp')}</span></a>
        </div>
      </div>
    </header>

    <main>
      <section class="land-wrap land-hero">
        <div class="land-copy">
          <p class="land-kicker" data-i18n="land.kicker">{T('land.kicker')}</p>
          <h1 class="land-h1" data-i18n="land.h1">{T('land.h1')}</h1>
          <p class="land-lead" data-i18n="land.lead">{T('land.lead')}</p>
          <div class="land-ctas">
            <a href="/projects" id="cta-main" class="btn btn-primary btn-lg"><span data-i18n="land.start">{T('land.start')}</span></a>
            <button type="button" id="cta-sample" class="btn btn-lg" data-i18n="land.sample">{T('land.sample')}</button>
          </div>
        </div>

        <!-- Animated logo card: adapted from Uiverse.io by Smit-Prajapati, with the Terra Script logo -->
        <div class="tc-stage">
          <div class="tc-card" id="logo-card" tabindex="0" role="img" aria-label="Terra Script">
            <div class="tc-border"></div>
            <div class="tc-content">
              <div class="tc-logo">
                <Logo id="lcard" class="tc-logo-svg" />
                <span class="tc-trail"></span>
              </div>
              <span class="tc-logo-bottom-text" data-i18n="land.cardTag">{T('land.cardTag')}</span>
            </div>
            <span class="tc-bottom-text" data-i18n="land.cardBottom">{T('land.cardBottom')}</span>
          </div>
        </div>
      </section>

      <section class="land-wrap land-features" aria-labelledby="features-title">
        <h2 id="features-title" class="land-h2" data-i18n="land.featuresTitle">{T('land.featuresTitle')}</h2>
        <!-- Flip cards: adapted from Uiverse.io by ElSombrero2, in Terra colours -->
        <ul class="land-grid">
          {features.map((f) => (
            <li class="flip-reveal">
              <div class="flip-card" tabindex="0" role="button" aria-pressed="false" aria-label={T(f.t)} data-i18n-aria={f.t}>
                <div class="flip-content">
                  <div class="flip-back">
                    <div class="flip-back-content">
                      <span class="flip-icon" set:html={f.icon} />
                      <strong class="flip-name" data-i18n={f.t}>{T(f.t)}</strong>
                      <span class="flip-hint" data-i18n="land.flipHint">{T('land.flipHint')}</span>
                    </div>
                  </div>
                  <div class="flip-front">
                    <div class="flip-img" aria-hidden="true">
                      <div class="flip-circle"></div>
                      <div class="flip-circle flip-circle-bottom"></div>
                      <div class="flip-circle flip-circle-right"></div>
                    </div>
                    <div class="flip-front-content">
                      <small class="flip-badge" data-i18n={f.b}>{T(f.b)}</small>
                      <div class="flip-description">
                        <div class="flip-title">
                          <p><strong data-i18n={f.t}>{T(f.t)}</strong></p>
                          <span class="flip-title-icon" set:html={f.icon} />
                        </div>
                        <p class="flip-text" data-i18n={f.d}>{T(f.d)}</p>
                        <p class="flip-footer">Terra Script</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="land-wrap land-footer">
      <span data-i18n="land.footer">{T('land.footer')}</span>
    </footer>

    <div id="toast" class="toast" role="status" hidden></div>
    <script>
      import '../scripts/landing';
    </script>
  </body>
</html>
