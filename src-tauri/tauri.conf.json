{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Terra Script",
  "mainBinaryName": "terra-script",
  "version": "1.0.3",
  "identifier": "com.terrascript.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321/projects",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/copy-installer.mjs --strip"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terra Script",
        "url": "projects",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Terra Script",
    "category": "Productivity",
    "shortDescription": "Screenwriting: write, plan and shoot your screenplay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
